# GEMINI_API_KEY: Required for server-side Gemini AI cybersecurity analysis.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPER_ADMIN credentials (server-side only, never exposed to browser bundle)
SUPER_ADMIN_USERNAME="superadmin"
SUPER_ADMIN_EMAIL="walidata@nagekeokab.go.id"
SUPER_ADMIN_ALLOWED_EMAILS="walidata@nagekeokab.go.id"
SUPER_ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"

# Server Security Secrets (auto-generated if omitted)
SESSION_SECRET="CHANGE_ME_RANDOM_64_HEX"
APPS_SCRIPT_SECRET="CHANGE_ME_WEBHOOK_SECRET_KEY"

# White-Label Multi-Kabupaten Defaults (also editable in Pengaturan UI)
REGENCY_NAME="Kabupaten Nagekeo"
PORTAL_NAME="Satu Data Nagekeo"
WALIDATA_NAME="Diskominfo Kabupaten Nagekeo"
REGENCY_DOMAIN="nagekeokab.go.id"
PUBLIC_PORTAL_URL=""

# Google BigQuery Data Warehouse (Opsional — Kedaulatan Data Region Jakarta asia-southeast2)
BIGQUERY_PROJECT_ID=""
BIGQUERY_DATASET_ID="satu_data_sektoral"
BIGQUERY_LOCATION="asia-southeast2"
BIGQUERY_SERVICE_ACCOUNT_JSON=""

# Cloudflare WAF, Strict Origin Lock & Turnstile (Opsional untuk Produksi di Belakang Cloudflare Proxy)
CLOUDFLARE_STRICT_ORIGIN="false"
CF_ORIGIN_VERIFY_SECRET=""
CLOUDFLARE_THREAT_THRESHOLD="35"
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

