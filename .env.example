# GEMINI_API_KEY: Required for server-side Gemini AI cybersecurity analysis.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPER_ADMIN credentials (server-side only, never exposed to browser bundle)
SUPER_ADMIN_USERNAME="superadmin"
SUPER_ADMIN_EMAIL="walidata@nagekeokab.go.id"
SUPER_ADMIN_ALLOWED_EMAILS="walidata@nagekeokab.go.id"
SUPER_ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
